#. Plugin URI of the plugin
#: feedback-pins.php
msgid "https://github.com/avangardism-alex/feedback-pins"
msgstr "https://github.com/avangardism-alex/feedback-pins"

#. Description of the plugin
#: feedback-pins.php
msgid "Pin feedback right on your pages. Clients click any element, write a note, and the whole team sees it on a shared board, with screenshots, Slack notifications and a Markdown export. Free, no account, everything stays in your WordPress."
msgstr "Vos retours épinglés directement sur les pages. Le client clique sur un élément, écrit sa remarque, et toute l’équipe la retrouve sur un tableau partagé, avec capture d’écran, notifications Slack et export Markdown. Gratuit, sans compte, tout reste dans votre WordPress."

#. Author of the plugin
#: feedback-pins.php
msgid "AVANGARDISM"
msgstr "AVANGARDISM"

#. Author URI of the plugin
#: feedback-pins.php
msgid "https://avangardism.com/?utm_source=feedback-pins&utm_medium=plugin&utm_campaign=plugin-header"
msgstr "https://avangardism.com/?utm_source=feedback-pins&utm_medium=plugin&utm_campaign=plugin-header"

